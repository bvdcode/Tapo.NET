<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Tapo.Samples</RootNamespace>
    <AssemblyName>tapo-cli</AssemblyName>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tapo\Tapo.csproj" />
  </ItemGroup>

  <ItemGroup Condition="Exists('secrets.json')">
    <None Include="secrets.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
